diff --git a/k8s/apps/be-modami-core-service/deployment.yaml b/k8s/apps/be-modami-core-service/deployment.yaml
new file mode 100644
index 0000000..6e99122
--- /dev/null
+++ b/k8s/apps/be-modami-core-service/deployment.yaml
@@ -0,0 +1,100 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: be-modami-core-service
+  namespace: modami
+  labels:
+    app: be-modami-core-service
+spec:
+  replicas: 3
+  selector:
+    matchLabels:
+      app: be-modami-core-service
+  template:
+    metadata:
+      labels:
+        app: be-modami-core-service
+      annotations:
+        vault.hashicorp.com/agent-inject: "true"
+        vault.hashicorp.com/agent-init-first: "true"
+        vault.hashicorp.com/agent-requests-cpu: "10m"
+        vault.hashicorp.com/agent-limits-cpu: "50m"
+        vault.hashicorp.com/agent-requests-mem: "32Mi"
+        vault.hashicorp.com/agent-limits-mem: "64Mi"
+        vault.hashicorp.com/role: "be-modami-core-service"
+        vault.hashicorp.com/agent-inject-token: "true"
+    spec:
+      serviceAccountName: be-modami-core-service
+      initContainers:
+        - name: consul-template
+          image: hashicorp/consul-template:0.37.6
+          resources:
+            requests:
+              memory: "32Mi"
+              cpu: "10m"
+            limits:
+              memory: "64Mi"
+              cpu: "50m"
+          env:
+            - name: CONSUL_HTTP_ADDR
+              value: "http://consul-server.consul.svc.cluster.local:8500"
+            - name: VAULT_ADDR
+              value: "http://vault.vault.svc.cluster.local:8200"
+          volumeMounts:
+            - name: config-output
+              mountPath: /app/config
+          command:
+            - /bin/sh
+            - -c
+            - |
+              export VAULT_ADDR="${VAULT_ADDR:-http://vault.vault.svc.cluster.local:8200}"
+              if [ -f /vault/secrets/token ]; then export VAULT_TOKEN=$(cat /vault/secrets/token); elif [ -f /vault/secrets/.vault-token ]; then export VAULT_TOKEN=$(cat /vault/secrets/.vault-token); fi
+              wget -qO /tmp/tpl.yml "${CONSUL_HTTP_ADDR}/v1/kv/modami/templates/be-modami-core-service?raw"
+              consul-template -template "/tmp/tpl.yml:/app/config/config.yml" -once
+      containers:
+        - name: core
+          image: lifegoeson34/be-modami-core-service:latest
+          resources:
+            requests:
+              memory: "128Mi"
+              cpu: "25m"
+            limits:
+              memory: "512Mi"
+              cpu: "500m"
+          ports:
+            - containerPort: 8080
+              name: http
+          volumeMounts:
+            - name: config-output
+              mountPath: /app/config
+              readOnly: true
+          command: ["/bin/sh", "-c", "exec ./main"]
+          livenessProbe:
+            tcpSocket:
+              port: 8080
+            initialDelaySeconds: 30
+            periodSeconds: 15
+            failureThreshold: 5
+          readinessProbe:
+            tcpSocket:
+              port: 8080
+            initialDelaySeconds: 10
+            periodSeconds: 10
+            failureThreshold: 5
+      volumes:
+        - name: config-output
+          emptyDir: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: be-modami-core-service
+  namespace: modami
+spec:
+  selector:
+    app: be-modami-core-service
+  ports:
+    - name: http
+      port: 8080
+      targetPort: 8080
+  type: ClusterIP
